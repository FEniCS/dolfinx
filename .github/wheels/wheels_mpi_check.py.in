# Check the MPI library matches the one family the DOLFINx wheels link.

import sys

_mpi_name, _mpi_file, _mpi_package = {
    "darwin": ("Open MPI", "libmpi.40.dylib", "openmpi"),
    "win32": ("Intel MPI", "impi.dll", "impi-rt"),
}.get(sys.platform, ("an MPICH ABI compatible MPI", "libmpi.so.12", "mpich"))
try:
    from mpi4py import MPI as _MPI

    _mpi_library = _MPI.Get_library_version()
except RuntimeError:
    _mpi_library = ""
if (
    not _mpi_library
    or ("Open MPI" in _mpi_library) != (sys.platform == "darwin")
    or (sys.platform == "win32" and "Intel" not in _mpi_library)
):
    _mpi_found = "no MPI library"
    if _mpi_library:
        _mpi_found = " ".join(_mpi_library.splitlines()[0].split(",")[0].split())
    # mpi4py does not record the libmpi path, so look it up in the loaded images.
    try:
        import ctypes
        import re

        if sys.platform == "darwin":
            _dyld = ctypes.CDLL(None)
            _image_name = _dyld._dyld_get_image_name
            _image_name.restype = ctypes.c_char_p
            _images = [_image_name(i).decode() for i in range(_dyld._dyld_image_count())]
        else:
            with open("/proc/self/maps") as _maps:
                _images = [line.split()[-1] for line in _maps]
        for _path in sorted({p for p in _images if re.search(r"/libmpi\.(so|[0-9]+\.dylib)", p)}):
            _mpi_found += f" ({_path})"
    except Exception:
        pass
    raise ImportError(
        f"DOLFINx wheels need {_mpi_name} ({_mpi_file}), e.g. pip install {_mpi_package}. "
        f"mpi4py loaded: {_mpi_found}"
    )
del _MPI, _mpi_name, _mpi_file, _mpi_package, _mpi_library
