# Keep build artefacts out of the build context. Only artefacts belong
# here: excluding source or configuration would silently starve a COPY.
# .git is deliberately kept, since cpp/CMakeLists.txt reads the commit
# hash from it into DOLFINX_GIT_COMMIT_HASH.

# Build and install trees
cpp/build*/
python/build*/
cpp/local*/

# Compiled objects and extension modules
**/*.o
**/*.a
**/*.so
**/*.so.*
**/*.dylib
**/*.dll
**/*.pyc
**/__pycache__/

# Generated sources and configuration
cpp/dolfinx/common/version.h
dolfinx.conf
DOLFINXConfig*.cmake
**/*.pc

# Documentation output
cpp/doc/html/
cpp/doc/latex/
cpp/doxygen/
python/doc/build/
python/doc/source/_autogenerated/
python/doc/source/generated/

# Test and demo output. Only extensions that .gitignore also ignores, so
# that a tracked fixture can never be dropped; .xdmf and .vtkhdf are
# deliberately absent, as both are tracked as test data.
**/test_*_tempdir/
**/Testing/
**/*.bp/
**/*.h5
**/*.pvd
**/*.pvtu
**/*.vtu

# CMake scratch, which also catches build trees nested under tests
# and demos without a broad build*/ rule
**/CMakeFiles/
**/CMakeCache.txt

# Downloaded archives (*.gz and *.xz are in .gitignore too)
**/*.gz
**/*.xz

# Editor and tool caches
**/.cache/
**/.mypy_cache/
**/.pytest_cache/
**/.ruff_cache/
**/*~
