+/* A handful of StratTab/Strat globals defined in libscotch are referenced
+** directly (not just via function calls) from libptscotch, crossing a DLL
+** boundary on Windows. CMAKE_WINDOWS_EXPORT_ALL_SYMBOLS only auto-exports
+** functions, not data, so these need explicit annotation. */
+#if defined scotch_EXPORTS
+#define SCOTCH_DATA                 __declspec(dllexport)
+#else /* defined scotch_EXPORTS */
+#define SCOTCH_DATA                 __declspec(dllimport)
+#endif /* defined scotch_EXPORTS */
 #endif /* COMMON_OS_WINDOWS */
 
+#ifndef SCOTCH_DATA
+#define SCOTCH_DATA
+#endif /* SCOTCH_DATA */
+
 #if ((! defined COMMON_OS_WINDOWS) && (! defined HAVE_NOT_UNISTD_H))
 #include            <unistd.h>
 #endif /* ((! defined COMMON_OS_WINDOWS) && (! defined HAVE_NOT_UNISTD_H)) */
