# LeakSanitizer suppressions for DOLFINx DeveloperDebug builds. These cover
# allocations made by MPI, PETSc and HDF5 that are reachable-but-leaked at
# process exit, not genuine DOLFINx leaks.
#
# Use with: LSAN_OPTIONS=suppressions=<path-to-this-file>
# MPI ranks must forward the environment, e.g. with Open MPI:
#   mpiexec -x LSAN_OPTIONS -n 3 ...

leak:libmpi
leak:libopen-pal
leak:libopen-rte
leak:mca_
leak:libpmix
leak:libpetsc
leak:libhdf5
leak:H5
