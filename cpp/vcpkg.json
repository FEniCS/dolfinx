{
  "$schema": "https://raw.githubusercontent.com/microsoft/vcpkg-tool/main/docs/vcpkg.schema.json",
  "dependencies": [
    "boost-algorithm",
    "boost-functional",
    "boost-lexical-cast",
    "boost-multiprecision",
    "boost-sort",
    "boost-unordered",
    "boost-uuid",
    "catch2",
    { "name": "hdf5",
      "features": [
        "parallel"
      ]
    },
    "mpi",
    "pugixml",
    "pkgconf",
    { "name": "scotch",
      "features": [
        "ptscotch"
      ]
    },
    "spdlog",
    "superlu-dist",
    "vcpkg-cmake",
    "vcpkg-cmake-config"
  ],
  "features": {
    "basix-from-source": {
      "description": "Build Basix from a local checkout via the basix overlay port, for CI cross-testing against Basix's current branch tip. Activate with -DVCPKG_MANIFEST_FEATURES=basix-from-source.",
      "dependencies": [
        "basix"
      ]
    }
  }
}
